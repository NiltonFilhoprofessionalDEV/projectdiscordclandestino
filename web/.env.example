# Local Supabase only. Copy to web/.env — never commit .env.
#
# App origin (Vite): http://localhost:5173
# Do not use the CLI Auth default http://127.0.0.1:3000 as redirect/site_url
# for this app. OAuth/email redirects must match the Vite origin:
#   http://localhost:5173
#   http://localhost:5173/
#
# Fill URL + publishable/anon key from `npx supabase status`.
# Never put SUPABASE_SECRET_KEY / service_role in this file or any VITE_* var.
#
# Seed user "Salas" (salas-owner@example.test) has no auth.identities/password
# and cannot sign in. Use AuthPage signup/login with a real account.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Vite dev origin — not the CLI Auth default http://127.0.0.1:3000
APP_ORIGIN=http://localhost:5173
PORT=8787

# Local Supabase (`npx supabase status`). Never use VITE_* on the server.
# Copy the secret/service_role key here. Do not put it in web/ or commit .env.
#
# Seed user "Salas" (salas-owner@example.test) has no auth.identities/password
# and cannot sign in. AuthPage uses real signup/login only.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
